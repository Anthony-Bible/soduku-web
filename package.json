{
  "name": "sudoku-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint .",
    "icons": "pwa-assets-generator",
    "wordlist": "tsx scripts/build-wordlist.ts",
    "dev:worker": "wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply sudoku --local",
    "e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "sql.js": "^1.15.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  }
}
